---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10131c" />
    <meta name="description" content="Catálogo de productos de demostración conectado a DummyJSON." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
